# ══════════════════════════════════════════════════════════════════
# FARO PROTOCOL — Variables de entorno (plantilla)
# Copiar a .env y completar con valores reales.
# NUNCA commitear el .env (está en .gitignore)
# ══════════════════════════════════════════════════════════════════

# ── Copernicus Data Space — descarga SAR Sentinel-1 ───────────────
# Registro gratuito: https://dataspace.copernicus.eu/register
COPERNICUS_USER=tu_email@ejemplo.com
COPERNICUS_PASS=tu_contraseña

# ── Groq — MachinaOS (Hermes + Paperclip con LLM) — costo $0 ────
# Registro gratuito: https://console.groq.com → API Keys
# Modelo usado: llama-3.3-70b-versatile (gratis en plan free)
GROQ_API_KEY=gsk_...

# ── Gmail — entrega de reportes a clientes (faro_deliver.py) ─────
# Requiere App Password (no la contraseña normal de Google)
# Obtener en: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
GMAIL_USER=protocolfaro@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# ── WhatsApp Gateway — alertas operacionales ─────────────────────
# Obtener en: Meta for Developers → WhatsApp Business API
WHATSAPP_TOKEN=...
WHATSAPP_PHONE_ID=...
WHATSAPP_DEST=+549...

# ════════════════════════════════════════════════════════════════════
# PORTAL SEGURO — Firebase Admin + Netlify (V10 · 9 capas)
# Estas variables también van en Netlify Dashboard → Environment variables
# ════════════════════════════════════════════════════════════════════

# ── Firebase Admin SDK (servidor — gen_portal_key.py + funciones Netlify) ──
# 1. console.firebase.google.com → Proyecto → Configuración → Cuentas de servicio
# 2. Generar nueva clave privada → descargar serviceAccount.json
# 3. Para .env local: ruta al JSON descargado
FIREBASE_SERVICE_ACCOUNT=/ruta/completa/al/serviceAccount.json

# ── Netlify: pegar el contenido JSON completo como string (una sola línea) ──
# En Netlify Dashboard → Environment variables → FIREBASE_SERVICE_ACCOUNT
# Valor: {"type":"service_account","project_id":"faro-protocol-906a5",...}

# ── Firebase proyecto ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=faro-protocol-906a5
PORTAL_URL=https://faroprotocol.netlify.app

# ── Signed URL Secret — CAPA 4 ───────────────────────────────────
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
# Mismo valor en Netlify Dashboard (variable: SIGNED_URL_SECRET)
SIGNED_URL_SECRET=GENERAR_CON_secrets_token_hex_32

# ── Admin email para alertas de seguridad ────────────────────────
ADMIN_EMAIL=protocolfaro@gmail.com
